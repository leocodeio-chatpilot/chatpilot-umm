{
  "name": "backend_chatpilot",
  "version": "1.2.4",
  "main": "dist/index.js",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/body-parser": "^1.19.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/dotenv": "^8.2.3",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "axios": "^1.7.8",
    "body-parser": "^1.20.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "nodemon": "^3.1.7",
    "prisma": "^5.22.0",
    "typescript": "^5.6.3",
    "zod": "^3.23.8",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "commitizen": "^4.3.1",
    "commitlint": "^19.7.1",
    "semantic-release": "^24.2.3"
  },
  "scripts": {
    "build": "npx esbuild src/index.ts --bundle --outfile=dist/index.js --platform=node --tsconfig=tsconfig.json",
    "start": "node dist/index.js",
    "dev": "nodemon --watch \"src/**\" --ext \"ts,json\" --ignore \"src/**/*.spec.ts\" --exec \"npx prisma generate && pnpm build && pnpm start\"",
    "prisma": "npx prisma migrate dev && npx prisma generate",
    "lint": "eslint src/**/*.ts",
    "prepare": "husky",
    "typecheck": "tsc",
    "commit": "cz",
    "approve-builds": "pnpm --filter=... dlx pnpm-approve-builds"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@commitlint/cz-commitlint": "^19.6.1",
    "@remix-run/dev": "^2.15.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^11.0.1",
    "@semantic-release/npm": "^12.0.1",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "husky": "^9.1.7"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  }
